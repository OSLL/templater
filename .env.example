# Copy to .env and fill in your own reCAPTCHA v3 (score-based) keys.
# Create them in Google Cloud -> reCAPTCHA; the secret is the "legacy secret
# key", because the app verifies tokens via the classic siteverify endpoint.
# Register every domain the app is served from (add localhost for local runs).
# .env is gitignored - keep the secret out of the repository.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
